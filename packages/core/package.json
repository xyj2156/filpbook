{
  "name": "@x-ac/filpbook-core",
  "version": "0.1.0",
  "type": "module",
  "description": "Framework-agnostic page-curl flip book engine",
  "sideEffects": false,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": ["dist", "README.md"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsc -p tsconfig.test.json && node --test \".tmp-test/*.test.js\""
  },
  "keywords": ["flipbook", "page-flip", "turn", "curl", "ebook"],
  "license": "MIT"
}
