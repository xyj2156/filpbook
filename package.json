{
  "name": "filp-book",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.11.2",
  "description": "Framework-agnostic page-curl flip book engine with Vue 3 and React wrappers",
  "scripts": {
    "dev": "vite",
    "build": "pnpm -r --filter @x-ac/filpbook-core --filter @x-ac/filpbook-vue --filter @x-ac/filpbook-react run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm -r run test",
    "shots": "node tools/shoot.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitejs/plugin-vue": "^6.0.10",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^5.9.3",
    "vite": "^8.3.4",
    "vue": "^3.5.44",
    "vue-tsc": "^3.3.13"
  }
}
