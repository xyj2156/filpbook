{
  "name": "flip-book",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Framework-agnostic page-curl flip book engine with Vue 3 and React wrappers",
  "scripts": {
    "dev": "vite",
    "build": "pnpm -r --filter @flipbook/core --filter @flipbook/vue --filter @flipbook/react run build",
    "typecheck": "tsc -p tsconfig.json --noEmit && pnpm -r run typecheck",
    "shots": "node tools/shoot.mjs"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.0.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vue": "^3.5.0",
    "vue-tsc": "^3.0.0"
  }
}
